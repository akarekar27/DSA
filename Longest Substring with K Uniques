class Solution:
    def longestKSubstr(self, s, k):
        l = 0
        mp = {}
        max_len = -1

        for r in range(len(s)):
            # Add current character to map count
            mp[s[r]] = mp.get(s[r], 0) + 1

            # Shrink window if unique characters exceed k
            while len(mp) > k:
                mp[s[l]] -= 1
                if mp[s[l]] == 0:
                    del mp[s[l]]
                l += 1

            # Record maximum length when exactly k unique characters exist
            if len(mp) == k:
                max_len = max(max_len, r - l + 1)

        return max_len
